# Copie este arquivo para ".env" antes de subir o docker-compose:
#   cp .env.example .env

# ---------- Banco de dados ----------
MYSQL_DATABASE=gestao-academico
MYSQL_ROOT_PASSWORD=root123
MYSQL_USER=academico
MYSQL_PASSWORD=academico123

# ---------- Backend ----------
# Perfil ativo do Spring: "docker" quando rodando via docker-compose,
# "local" quando rodando com ./mvnw fora de container.
SPRING_PROFILES_ACTIVE=docker

# Chave secreta usada para assinar os tokens JWT (Base64, HMAC-SHA).
# Pode gerar uma nova com: openssl rand -base64 64
JWT_SECRET=NuEDTlWWH/WitmbS7jdO2NiU0LICTGhNTY2rcqjq0adAzCS6kBRBgrkCmwXK+nReqh+Y9stgKEcHCnbZ3H213w==
# Tempo de expiracao do token, em milissegundos (86400000 = 24h)
JWT_EXPIRATION=86400000

# Origens permitidas para chamadas via CORS. Se o frontend estiver rodando
# via "docker compose" com proxy reverso do Nginx (ver README do frontend),
# as chamadas chegam pela mesma origem do frontend e o CORS praticamente nao
# entra em acao; mas mantenha isso configurado para cobrir o cenario de
# `ng serve` (desenvolvimento local, http://localhost:4200).
CORS_ALLOWED_ORIGINS=http://localhost:4200
CORS_ALLOWED_METHODS=GET,POST,PUT,DELETE,OPTIONS,PATCH
CORS_ALLOWED_HEADERS=Authorization,Cache-Control,Content-Type

# Porta publicada no host para acessar a API (http://localhost:<esta porta>)
BACKEND_PORT=8080
